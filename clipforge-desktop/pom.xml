<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.clipforge</groupId>
        <artifactId>clipforge-parent</artifactId>
        <version>1.2.0</version>
    </parent>

    <artifactId>clipforge-desktop</artifactId>
    <name>ClipForge Desktop</name>
    <description>JavaFX desktop application.</description>

    <dependencies>
        <dependency>
            <groupId>com.clipforge</groupId>
            <artifactId>clipforge-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.clipforge.desktop/com.clipforge.desktop.ClipForgeApp</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics,com.clipforge.core,com.microsoft.onnxruntime</option>
                    </options>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvnw -Pdist package: copies the runtime modules to target/lib for jpackage (see packaging/) -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-runtime</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${project.build.directory}/lib</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- ONNX Runtime has no module descriptor; jlink (used by jpackage) refuses automatic modules, so the
                         copied jar gets one (its native libraries stay inside and are extracted at run time) -->
                    <plugin>
                        <groupId>org.moditect</groupId>
                        <artifactId>moditect-maven-plugin</artifactId>
                        <version>1.3.0.Final</version>
                        <executions>
                            <execution>
                                <id>onnxruntime-module</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>add-module-info</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/lib</outputDirectory>
                                    <overwriteExistingFiles>true</overwriteExistingFiles>
                                    <modules>
                                        <module>
                                            <artifact>
                                                <groupId>com.microsoft.onnxruntime</groupId>
                                                <artifactId>onnxruntime</artifactId>
                                                <version>${onnxruntime.version}</version>
                                            </artifact>
                                            <moduleInfoSource>
                                                module com.microsoft.onnxruntime {
                                                    requires java.logging;
                                                    exports ai.onnxruntime;
                                                    exports ai.onnxruntime.platform;
                                                    exports ai.onnxruntime.providers;
                                                }
                                            </moduleInfoSource>
                                        </module>
                                    </modules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
